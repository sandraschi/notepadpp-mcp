{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "mcpServers": {
    "notepadpp-mcp": {
      "command": "python",
      "args": ["-m", "notepadpp_mcp.server"],
      "env": {
        "PYTHONPATH": "${__dirname}",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "FastMCP 3.4.4 Notepad++ automation: 8 portmanteau tools, sampling, prompts, skill:// resources, agentic_notepad_workflow.",
      "capabilities": {
        "tools": {
          "enabled": true
        },
        "resources": {
          "enabled": true
        },
        "prompts": {
          "enabled": true
        }
      },
      "timeout": {
        "initialize": 30000,
        "message": 60000
      },
      "metadata": {
        "version": "0.2.1",
        "author": "Sandra Schi",
        "homepage": "https://github.com/sandraschi/notepadpp-mcp",
        "license": "MIT",
        "tags": [
          "notepadpp",
          "text-editor",
          "windows",
          "automation",
          "plugins",
          "linting",
          "mcp-server",
          "fastmcp"
        ],
        "categories": [
          "text-editor",
          "automation",
          "code-quality",
          "windows"
        ]
      }
    }
  },
  "maintainers": ["sandraschi"],
  "name": "notepadpp-mcp",
  "description": "FastMCP 3.4.4 MCP server for Notepad++ automation, plugin management, and code quality analysis. Uses 8 portmanteau tools consolidating 26 operations. Includes plugin ecosystem integration with 1,400+ plugins.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 3.4.4",
  "tools": 8,
  "transport": ["stdio"],
  "keywords": [
    "notepadpp",
    "text-editor",
    "windows",
    "automation",
    "plugins",
    "linting",
    "mcp-server",
    "fastmcp"
  ],
  "features": {
    "plugin_management": {
      "enabled": true,
      "ecosystem": "1400+ official plugins"
    },
    "code_linting": {
      "enabled": true,
      "languages": ["Python", "JavaScript", "JSON", "Markdown"]
    },
    "automation": {
      "enabled": true
    }
  }
}
