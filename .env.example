# notepadpp-mcp environment template.
# Copy to .env (repo root) and fill in values. Never commit .env.
# The webapp reads its own copies via web_sota/.env (VITE_MCP_WEB_USER / VITE_MCP_WEB_PASSWORD).

# --- Dashboard API auth (OPTIONAL - leave empty to disable auth / open localhost) ---
# Set both to lock the dashboard API with HTTP Basic auth. No defaults exist.
MCP_WEB_USER=
MCP_WEB_PASSWORD=

# --- Optional local LLM for the Chat page (Ollama default) ---
AI_PROVIDER=ollama
AI_ENDPOINT=http://127.0.0.1:11434/api/generate
AI_MODEL=llama3.1-8b

# --- MCP sampling (server-side LLM for agentic workflows; Ollama-compatible) ---
NOTEPADPP_SAMPLING_BASE_URL=http://127.0.0.1:11434/v1
NOTEPADPP_SAMPLING_MODEL=llama3.1-8b
# Set to 1 to let the MCP client host run the LLM instead (no server-side key needed)
NOTEPADPP_SAMPLING_USE_CLIENT_LLM=0
# Optional: OpenAI-compatible key for sampling (only if NOTEPADPP_SAMPLING_USE_OPENAI_KEY=1)
NOTEPADPP_SAMPLING_USE_OPENAI_KEY=0
# NOTEPADPP_SAMPLING_API_KEY=

# --- HTTP bridge ---
# NOTEPADPP_PORT=10815
# NOTEPADPP_HOST=127.0.0.1
# MCP_PORT=10815
# MCP_TRANSPORT=http

# --- Optional bridge to other MCP servers (comma-separated URLs) ---
# MCP_BRIDGE_URLS=

# --- Notepad++ integration ---
# NOTEPADPP_PATH=C:\Program Files\Notepad++\notepad++.exe
# NOTEPADPP_AUTO_START=true
# NOTEPADPP_TIMEOUT=30
# NOTEPADPP_SESSION_STORAGE_DIR=
# NOTEPADPP_CONFIG_XML=
# NOTEPADPP_LIVE_SESSION_XML=
# NOTEPADPP_PLUGIN_LIST_URL=
# NOTEPADPP_PLUGIN_CATALOG_TTL_SEC=
# NOTEPADPP_FLEET_REGISTRY=
# NOTEPADPP_FLEET_MAX_PORTS=

# --- Dev ---
# SKIP_SYNC=1
# NOTEPADPP_GUI_TEST=1
